{
  "name": "broker-portfolio-agent-web",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && esbuild src/main.tsx --bundle --minify --format=iife --jsx=automatic --target=es2020 --outfile=../app/static/app.js",
    "watch": "esbuild src/main.tsx --bundle --format=iife --jsx=automatic --target=es2020 --outfile=../app/static/app.js --watch"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
